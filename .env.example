# ==============================================================================
# Bask Health Intake Studio — Environment Configuration Example
# Copy this file to .env.local for local development.
# DO NOT COMMIT REAL CREDENTIALS, DB PASSWORDS, OR SECRETS TO SOURCE CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Client & Authentication (Publicly Exposable)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ------------------------------------------------------------------------------
# 2. Database Connection (SERVER-SIDE ONLY - NEVER LEAK TO CLIENT)
# ------------------------------------------------------------------------------
# Direct URL for schema migrations and DDL (Supabase port 5432)
DATABASE_DIRECT_URL=

# Pooled URL for application queries in serverless functions (Supabase transaction pooler port 6543)
DATABASE_URL=

# ------------------------------------------------------------------------------
# 3. Application Security & Cryptography
# ------------------------------------------------------------------------------
# High-entropy 32-byte secret for patient session recovery HMAC digests
APP_SESSION_PEPPER=

# Base URL for metadata and public intake link generation
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 4. Reviewer Test Credentials (Used for E2E / local testing only)
# ------------------------------------------------------------------------------
E2E_REVIEWER_EMAIL=
E2E_REVIEWER_PASSWORD=

